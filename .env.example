# Face Tracking & Logging System — Environment Configuration
# Copy this file to .env and update the values

# ── Database ──────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/face_tracking.db

# ── Face Recognition ─────────────────────────────────────
# Cosine similarity threshold (0.0–1.0). Lower = stricter matching.
MATCH_THRESHOLD=0.5
# InsightFace model pack name (buffalo_l, buffalo_m, buffalo_s, buffalo_sc)
INSIGHTFACE_MODEL=buffalo_s

# ── Stream Processing ────────────────────────────────────
# Process every Nth frame (higher = less CPU, slower detection)
FRAME_SKIP=5
# Downscale factor for detection (0.0–1.0)
DOWNSCALE_FACTOR=0.5
# Seconds before re-logging the same person on the same camera
COOLDOWN_SECONDS=60
# Max reconnection backoff seconds for dropped RTSP streams
MAX_RECONNECT_BACKOFF=30

# ── Storage ──────────────────────────────────────────────
SNAPSHOT_DIR=./data/snapshots
REFERENCE_PHOTO_DIR=./data/reference_photos
# Snapshot file retention in days (e.g. 1, 7, 30, 90). 0 = Keep forever (No expiry).
SNAPSHOT_RETENTION_DAYS=30
# Event log retention in days (e.g. 7, 30, 90, 180, 365). 0 = Keep forever (No expiry).
EVENT_LOG_RETENTION_DAYS=0
# Monthly archive directory for standalone databases & snapshot partitions (e.g. ./data/archives or E:\face_archives)
ARCHIVE_DIR=./data/archives
AUTO_ARCHIVE_MONTHLY=True

# ── Server ───────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
SAVE_SNAPSHOTS=True
LOG_UNKNOWN_FACES=True
ROI_CROP_ENABLED=False
LIVE_PREVIEW_FPS=2.0